DB_USER='root'
DB_HOST='localhost'
DB_NAME='noctua_bd'
DB_PASSWORD='admin'
DB_PORT=3306

RESEND_API_KEY='sua_chave_aqui'

# AWS S3 - leitura do JSON Gold de processos pela aplicação web
# As credenciais precisam ter permissão de GetObject e ListObjectsV2 no bucket.
BUCKET_NAME=noctua-s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua_key_aqui
AWS_SECRET_ACCESS_KEY=seu_secret_aqui
AWS_SESSION_TOKEN=seu_token_aqui
